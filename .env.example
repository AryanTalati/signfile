# Every variable the app reads. Copy to .env.local and fill in. Never commit real values.

# --- Database (Supabase Postgres) ---
# SESSION pooler URI (port 5432 on the *.pooler.supabase.com host). We run one
# long-lived server, which is what session mode is for. The transaction pooler
# (port 6543) hung requests under concurrent load (see DECISIONS.md).
# Clients still set prepare:false, which works in either mode.
DATABASE_URL=
# App connection pool size per process (default 3). Session mode holds one pooler
# connection per client connection, and Supabase's default pool size is 15 per role:
# keep (app pool + 1 health check) x 2 (deploy overlap) + local tools under 15.
DB_POOL_MAX=3

# Optional: separate URI for migrations. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# --- Supabase Storage (PDFs, logos; private bucket) ---
SUPABASE_URL=
# Secret key (sb_secret_...). Server-side only; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name. Created by `npm run db:setup` if missing.
STORAGE_BUCKET=signfile

# --- DOCX conversion ---
# Path to LibreOffice's soffice. Leave empty in Docker (on PATH). macOS:
# /Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=
# Pre-built LibreOffice profile dir (set in the Dockerfile). Leave empty locally.
LO_PROFILE_DIR=
# TEST ONLY: enables POST /api/test/automations (mocked time) and turns off the reminder sweep.
# Set for the local Docker E2E run. Never set on Render.
E2E_HOOKS=
# Runs the reminder/expiry sweep on the /api/health ping. Set ONLY on Render (=1); leave empty
# locally and in Docker, which share the production database.
ENABLE_SWEEP=

# --- AI review of new agreements (optional; rules-only without a key) ---
# Claude API key (set a monthly spend limit in the Anthropic console). Never logged.
ANTHROPIC_API_KEY=
# "false" turns the AI review off even with a key.
AI_ENABLED=
# Review calls per company per 24 hours (default 20).
AI_DAILY_CAP=
# Model override (default claude-opus-5-5).
AI_MODEL=
# Tests only (Docker E2E): mock model for "E2E AI" companies. Never on Render.
LLM_MOCK=
