# Copy to .env.local for development. Never commit real values.

# Supabase Postgres, TRANSACTION pooler (port 6543). Used by the running app.
# Prepared statements are not supported through it: the DB client sets prepare:false.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase SESSION pooler (port 5432, same host). Used only by migrations
# (`npm run db:migrate`): they need session-level features the transaction pooler
# doesn't keep. Supabase's direct host is IPv6-only on the free plan; the session
# pooler works over IPv4. Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Path to LibreOffice's soffice binary. In Docker it's on PATH; on macOS:
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=
